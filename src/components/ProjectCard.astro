---
import BaseCard from './BaseCard.astro';
import ForwardLink from './ForwardLink.astro';

interface Props {
  title: string;
  slug: string;
  outcomeSummary: string;
  role: string;
  year: number;
  techStack?: string[];
  status?: 'completed' | 'ongoing' | 'archived';
  stageLabel?: string;
  cover?: { src: string; alt: string };
}

const { title, slug, outcomeSummary, role, year, techStack = [], status = 'completed', stageLabel, cover } = Astro.props;
const displayTech = techStack.slice(0, 4);
const hasMoreTech = techStack.length > 4;
const defaultStage = { completed: '已完成', ongoing: '持续迭代', archived: '已归档' }[status];
---

<BaseCard href={`/projects/${slug}`} class="project-card">
  {cover ? (
    <img slot="cover" class="project-cover" src={cover.src} alt={cover.alt} loading="lazy" width="960" height="540" />
  ) : slug === 'cexing' ? (
    <div slot="cover" class="project-cover cexing-cover" aria-hidden="true"><span>CEXING</span><span>策星 · HarmonyOS</span><span class="cexing-path">原生界面 → 系统连接 → 代理内核</span></div>
  ) : null}
  <div slot="badge" class="card-badges">
    <span class:list={['status-badge', `status--${status}`]}>{stageLabel ?? defaultStage}</span>
  </div>
  <Fragment slot="meta">{role} · {year}</Fragment>
  <Fragment slot="title">{title}</Fragment>
  <Fragment slot="description">{outcomeSummary}</Fragment>
  {displayTech.length > 0 && (
    <div slot="tags" class="tags-list">
      {displayTech.map((tech) => <span class="tag">{tech}</span>)}
      {hasMoreTech && <span class="tag-more">+{techStack.length - 4}</span>}
    </div>
  )}
  <ForwardLink text="详情" />
</BaseCard>

<style>
  .project-cover { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; object-position: top; margin: 0 0 1.5rem; border-radius: 3px; background: var(--color-bg-elevated); }
  .cexing-cover { display: flex; flex-direction: column; justify-content: center; gap: .6rem; padding: 2rem; color: var(--color-text); background: radial-gradient(ellipse at top right, rgba(20, 184, 166, .12), transparent 70%), var(--color-bg-elevated); }
  .cexing-cover > span:first-child { font-size: clamp(1.6rem, 4vw, 2.8rem); letter-spacing: .18em; font-weight: 600; }
  .cexing-cover > span { font-size: .85rem; }
  .cexing-cover .cexing-path { margin-top: 1.25rem; font-size: .7rem; color: var(--color-text-secondary); }

  .card-badges { display: flex; align-items: center; flex-wrap: wrap; gap: .6rem; margin-bottom: .75rem; }
  .status-badge { font-size: .65rem; font-weight: 650; letter-spacing: .04em; padding: .25rem .5rem; border-radius: 4px; background: var(--color-bg-elevated); color: var(--color-text-muted); border: 1px solid var(--color-border); }
  .status--ongoing { color: #22c55e; }
  .tag-more { font-size: .75rem; padding: .25rem .5rem; color: var(--color-text-muted); }
</style>
