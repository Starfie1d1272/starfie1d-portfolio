---
import BaseLayout from '../layouts/BaseLayout.astro';
import SEO from '../components/SEO.astro';
import StructuredData from '../components/StructuredData.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ForwardLink from '../components/ForwardLink.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../config';

const featuredProjects = (await getCollection('projects'))
  .filter((project) => project.data.featured)
  .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999))
  .slice(0, 4);

const recentDecisions = (await getCollection('decisions'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
---

<BaseLayout>
  <SEO slot="head" title={siteConfig.title} description={siteConfig.description} type="website" noSuffix />
  <StructuredData type="WebSite" />
  <StructuredData type="Person" />

  <main class="home-page">
    <section class="hero">
      <p class="eyebrow">南京大学 · 2027 届</p>
      <h1>杜鑫宇</h1>
      <p class="hero-copy">
        赛事运营、赛事平台、CS2 制播和 Demo 分析。这里放几个我自己长期做的项目。
      </p>
      <div class="hero-actions">
        <a class="btn-primary" href="/projects">项目</a>
        <a class="btn-secondary" href="/decisions">决定</a>
        <a class="btn-secondary" href="https://starfie1d.top" target="_blank" rel="noopener noreferrer">个人主页 ↗</a>
      </div>
    </section>

    <section class="section-block">
      <div class="section-header">
        <h2>项目</h2>
        <ForwardLink href="/projects" text="全部项目" variant="muted" />
      </div>
      <div class="project-grid">
        {featuredProjects.map((project) => (
          <ProjectCard
            title={project.data.title}
            slug={project.id}
            outcomeSummary={project.data.outcomeSummary}
            role={project.data.role}
            year={project.data.year}
            techStack={project.data.techStack}
            status={project.data.status}
            stageLabel={project.data.stageLabel}
          />
        ))}
      </div>
    </section>

    <section class="section-block">
      <div class="section-header">
        <h2>决定</h2>
        <ForwardLink href="/decisions" text="全部决定" variant="muted" />
      </div>
      <div class="decision-list">
        {recentDecisions.map((decision) => (
          <a href={`/decisions/${decision.id}`} class="decision-row">
            <span class="decision-date">
              {decision.data.date.toLocaleDateString('zh-CN', { month: '2-digit', day: '2-digit' })}
            </span>
            <span class="decision-title">{decision.data.title}</span>
            <span class="decision-arrow">→</span>
          </a>
        ))}
      </div>
    </section>
  </main>

  <style>
    .home-page { max-width: 1080px; margin: 0 auto; padding: 0 1.5rem 5rem; }
    .hero { padding: 4rem 0 3.25rem; border-bottom: 1px solid var(--color-border); }
    .eyebrow { font-size: .75rem; font-weight: 600; letter-spacing: .04em; color: var(--color-text-muted); }
    .hero h1 { margin: .65rem 0 .9rem; font-size: clamp(2rem, 4vw, 3.25rem); line-height: 1.1; letter-spacing: -.035em; }
    .hero-copy { max-width: 680px; color: var(--color-text-secondary); font-size: 1rem; line-height: 1.75; }
    .hero-actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1.6rem; }
    .btn-primary, .btn-secondary { display: inline-flex; align-items: center; padding: .65rem .95rem; border-radius: 6px; font-size: .88rem; font-weight: 600; text-decoration: none; }
    .btn-primary { background: var(--color-text); color: var(--color-bg); }
    .btn-secondary { border: 1px solid var(--color-border); color: var(--color-text); }
    .section-block { padding: 3.5rem 0; border-bottom: 1px solid var(--color-border); }
    .section-header { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: 1.5rem; }
    .section-header h2 { margin: 0; font-size: 1.45rem; letter-spacing: -.02em; }
    .project-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }
    .decision-list { border-top: 1px solid var(--color-border); }
    .decision-row { display: grid; grid-template-columns: 72px 1fr auto; gap: 1rem; align-items: center; padding: 1.1rem 0; border-bottom: 1px solid var(--color-border); color: var(--color-text); text-decoration: none; }
    .decision-date { color: var(--color-text-muted); font-size: .8rem; }
    .decision-title { font-weight: 550; }
    .decision-arrow { color: var(--color-text-muted); }
    @media (max-width: 760px) { .project-grid { grid-template-columns: 1fr; } }
    @media (max-width: 640px) {
      .home-page { padding: 0 1rem 3rem; }
      .hero { padding: 3rem 0 2.5rem; }
      .section-block { padding: 3rem 0; }
      .decision-row { grid-template-columns: 58px 1fr auto; gap: .6rem; }
    }
  </style>
</BaseLayout>
