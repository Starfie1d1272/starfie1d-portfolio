---
import BaseLayout from '../layouts/BaseLayout.astro';
import SEO from '../components/SEO.astro';
import StructuredData from '../components/StructuredData.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ForwardLink from '../components/ForwardLink.astro';
import { getCollection } from 'astro:content';
import { siteConfig } from '../config';

const featuredProjects = (await getCollection('projects'))
  .filter((project) => project.data.featured)
  .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999))
  .slice(0, 3);

const recentDecisions = (await getCollection('decisions'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
---

<BaseLayout>
  <SEO slot="head" title={siteConfig.title} description={siteConfig.description} type="website" noSuffix />
  <StructuredData type="WebSite" />
  <StructuredData type="Person" />

  <main class="home-page">
    <section class="hero">
      <p class="eyebrow">杜鑫宇 · 南京大学 · 2027 届</p>
      <h1>我做过几个自己长期维护的产品。</h1>
      <p class="hero-copy">
        主要是高校电竞赛事、CS2 制播和 Demo 分析。都有真实使用场景，也都经历过上线、返工和继续迭代。
        这里先放三个现在最能代表我的项目。
      </p>
      <div class="hero-actions">
        <a class="btn-primary" href="/projects">看项目</a>
        <a class="btn-secondary" href="/decisions">看几个具体决定</a>
        <a class="btn-secondary" href="https://starfie1d.top" target="_blank" rel="noopener noreferrer">个人主页 ↗</a>
      </div>
    </section>

    <section class="section-block">
      <div class="section-header">
        <div>
          <p class="section-kicker">项目</p>
          <h2>现在主要在做这些</h2>
        </div>
        <ForwardLink href="/projects" text="查看全部项目" variant="muted" />
      </div>
      <div class="project-grid">
        {featuredProjects.map((project) => (
          <ProjectCard
            title={project.data.title}
            slug={project.id}
            outcomeSummary={project.data.outcomeSummary}
            role={project.data.role}
            year={project.data.year}
            techStack={project.data.techStack}
            featured={project.data.featured}
            status={project.data.status}
            stageLabel={project.data.stageLabel}
          />
        ))}
      </div>
    </section>

    <section class="section-block">
      <div class="section-header">
        <div>
          <p class="section-kicker">项目里的决定</p>
          <h2>几个当时需要认真取舍的问题</h2>
        </div>
        <ForwardLink href="/decisions" text="查看全部" variant="muted" />
      </div>
      <div class="decision-list">
        {recentDecisions.map((decision) => (
          <a href={`/decisions/${decision.id}`} class="decision-row">
            <span class="decision-date">
              {decision.data.date.toLocaleDateString('zh-CN', { month: '2-digit', day: '2-digit' })}
            </span>
            <span class="decision-title">{decision.data.title}</span>
            <span class="decision-arrow">→</span>
          </a>
        ))}
      </div>
    </section>
  </main>

  <style>
    .home-page { max-width: 1080px; margin: 0 auto; padding: 0 1.5rem 5rem; }
    .hero { padding: 5.5rem 0 4.5rem; border-bottom: 1px solid var(--color-border); }
    .eyebrow, .section-kicker { font-size: .75rem; font-weight: 650; letter-spacing: .08em; color: var(--color-text-muted); }
    .hero h1 { max-width: 820px; margin: .8rem 0 1.4rem; font-size: clamp(2.6rem, 6vw, 5rem); line-height: 1.05; letter-spacing: -.045em; }
    .hero-copy { max-width: 760px; color: var(--color-text-secondary); font-size: 1.15rem; line-height: 1.8; }
    .hero-actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 2rem; }
    .btn-primary, .btn-secondary { display: inline-flex; align-items: center; padding: .7rem 1rem; border-radius: 6px; font-size: .9rem; font-weight: 600; text-decoration: none; }
    .btn-primary { background: var(--color-text); color: var(--color-bg); }
    .btn-secondary { border: 1px solid var(--color-border); color: var(--color-text); }
    .section-block { padding: 4rem 0; border-bottom: 1px solid var(--color-border); }
    .section-header { display: flex; justify-content: space-between; align-items: end; gap: 1rem; margin-bottom: 1.5rem; }
    .section-block h2 { margin-top: .4rem; font-size: 1.65rem; letter-spacing: -.02em; }
    .project-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem; }
    .decision-list { border-top: 1px solid var(--color-border); }
    .decision-row { display: grid; grid-template-columns: 72px 1fr auto; gap: 1rem; align-items: center; padding: 1.1rem 0; border-bottom: 1px solid var(--color-border); color: var(--color-text); text-decoration: none; }
    .decision-date { color: var(--color-text-muted); font-size: .8rem; }
    .decision-title { font-weight: 550; }
    .decision-arrow { color: var(--color-text-muted); }
    @media (max-width: 900px) { .project-grid { grid-template-columns: 1fr; } }
    @media (max-width: 640px) {
      .home-page { padding: 0 1rem 3rem; }
      .hero { padding: 3.5rem 0 3rem; }
      .hero-copy { font-size: 1rem; }
      .section-block { padding: 3rem 0; }
      .section-header { align-items: flex-start; flex-direction: column; }
      .decision-row { grid-template-columns: 58px 1fr auto; gap: .6rem; }
    }
  </style>
</BaseLayout>
