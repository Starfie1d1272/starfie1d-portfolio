---
import { siteConfig } from '../config';
---
<!DOCTYPE html>
<html lang={siteConfig.language}>
<head>
  <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>页面不存在｜{siteConfig.author.name}</title><meta name="robots" content="noindex, nofollow" />
  <style>
    :root{--bg:#0a0a0a;--text:#e5e5e5;--muted:#a3a3a3}[data-theme="light"]{--bg:#fff;--text:#171717;--muted:#525252}
    *{box-sizing:border-box}body{margin:0;min-height:100vh;display:grid;place-items:center;padding:2rem;background:var(--bg);color:var(--text);font-family:system-ui,-apple-system,"PingFang SC","Microsoft YaHei",sans-serif}
    main{max-width:520px;text-align:center}.code{color:var(--muted);font-size:.8rem;letter-spacing:.08em}h1{margin:.7rem 0 1rem;font-size:2rem}p{color:var(--muted);line-height:1.75}
    a{display:inline-block;margin-top:1.5rem;padding:.7rem 1rem;border:1px solid #444;border-radius:6px;color:var(--text);text-decoration:none}
  </style>
  <script is:inline>(function(){const stored=localStorage.getItem('theme');const theme=stored||(window.matchMedia('(prefers-color-scheme: light)').matches?'light':'dark');document.documentElement.setAttribute('data-theme',theme)})();</script>
</head>
<body><main><div class="code">404</div><h1>这个页面不存在。</h1><p>链接可能已经调整，或者你打开了还没有发布的内容。</p><a href="/">返回首页</a></main></body>
</html>
