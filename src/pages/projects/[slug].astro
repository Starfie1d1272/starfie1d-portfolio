---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SEO from '../../components/SEO.astro';
import StructuredData from '../../components/StructuredData.astro';
import ScrollToTop from '../../components/ScrollToTop.astro';
import BackLink from '../../components/BackLink.astro';
import RelatedContent from '../../components/RelatedContent.astro';
import ImpactMetrics from '../../components/ImpactMetrics.astro';
import { getCollection, getEntry, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id } }));
}

const { slug } = Astro.params;
const project = await getEntry('projects', slug!);
if (!project) return Astro.redirect('/404');

const { Content } = await render(project);
const {
  title,
  role,
  year,
  duration,
  outcomeSummary,
  metricsGroups,
  timeline,
  screenshots,
  evidenceSections,
  keyDecisions,
  techStack,
  learnings,
  relatedProjects,
  relatedDecisions,
  status,
  stageLabel,
  showcaseCommit,
  links,
} = project.data;

const defaultStage = { completed: '已完成', ongoing: '持续迭代', archived: '已归档' }[status || 'completed'];
const linkItems = [
  links?.live && { label: '线上产品 ↗', href: links.live },
  links?.github && { label: 'GitHub ↗', href: links.github },
  links?.release && { label: 'Release ↗', href: links.release },
].filter(Boolean) as { label: string; href: string }[];
---

<BaseLayout>
  <SEO slot="head" title={title} description={outcomeSummary} type="article" />
  <StructuredData type="Project" data={{ title, outcomeSummary, techStack, year }} />

  <main class="case-study">
    <header class="case-study-header">
      <div class="header-badges">
        <span class:list={['status-badge', `status--${status}`]}>{stageLabel ?? defaultStage}</span>
      </div>
      <h1>{title}</h1>
      <div class="case-study-meta">
        <span>{role}</span><span>·</span><span>{duration ?? year}</span>
        {showcaseCommit && <><span>·</span><span>展示基线 {showcaseCommit.slice(0, 7)}</span></>}
      </div>
      <p class="outcome-summary">{outcomeSummary}</p>
      {linkItems.length > 0 && (
        <div class="project-links">
          {linkItems.map((link) => <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a>)}
        </div>
      )}
    </header>

    {metricsGroups?.map((group) => (
      <section class="case-study-section metric-group">
        <div class="section-title-row">
          <h2>{group.title}</h2>
          {group.asOf && <span>{group.asOf}</span>}
        </div>
        <ImpactMetrics metrics={group.metrics} />
      </section>
    ))}

    {screenshots && screenshots.length > 0 && (
      <section class="case-study-section">
        <h2>界面</h2>
        <div class="screenshot-list">
          {screenshots.map((shot) => (
            <figure class="project-shot">
              <img src={shot.src} alt={shot.alt} loading="lazy" />
              {shot.caption && <figcaption>{shot.caption}</figcaption>}
            </figure>
          ))}
        </div>
      </section>
    )}

    {timeline && timeline.length > 0 && (
      <section class="case-study-section">
        <h2>时间线</h2>
        <div class="timeline">
          {timeline.map((item) => (
            <article class="timeline-item">
              <div class="timeline-year">{item.year}</div>
              <div>
                <h3>{item.title}</h3>
                <p>{item.summary}</p>
                {item.metrics && item.metrics.length > 0 && (
                  <div class="timeline-metrics">
                    {item.metrics.map((metric) => (
                      <span><strong>{metric.value}</strong> {metric.label}</span>
                    ))}
                  </div>
                )}
              </div>
            </article>
          ))}
        </div>
      </section>
    )}

    {evidenceSections?.map((section) => (
      <section class="case-study-section">
        <h2>{section.title}</h2>
        {section.description && <p>{section.description}</p>}
        <div class="evidence-grid">
          {section.items.map((item) => (
            item.kind === 'image' ? (
              <figure class="evidence-item">
                <img src={item.src} alt={item.alt ?? item.label} loading="lazy" />
                <figcaption>
                  <strong>{item.label}</strong>
                  {item.caption && <span>{item.caption}</span>}
                </figcaption>
              </figure>
            ) : (
              <a class="file-evidence" href={item.src} target="_blank" rel="noopener noreferrer">
                <strong>{item.label}</strong>
                {item.caption && <span>{item.caption}</span>}
                <span class="file-open">打开原文件 ↗</span>
              </a>
            )
          ))}
        </div>
      </section>
    ))}

    {project.body && project.body.trim().length > 0 && (
      <section class="case-study-content"><Content /></section>
    )}

    {keyDecisions && keyDecisions.length > 0 && (
      <section class="case-study-section">
        <h2>几个决定</h2>
        <div class="decisions-list">
          {keyDecisions.map((item) => (
            <article class="decision-item">
              <h3>{item.decision}</h3>
              <p>{item.reasoning}</p>
              {item.alternatives && item.alternatives.length > 0 && (
                <div class="alternatives">
                  <strong>当时也考虑过</strong>
                  <ul>{item.alternatives.map((alt) => <li>{alt}</li>)}</ul>
                </div>
              )}
            </article>
          ))}
        </div>
      </section>
    )}

    {techStack && techStack.length > 0 && (
      <section class="case-study-section">
        <h2>技术栈</h2>
        <div class="tag-cloud">{techStack.map((tech) => <span>{tech}</span>)}</div>
      </section>
    )}

    {learnings && learnings.length > 0 && (
      <section class="case-study-section">
        <h2>补充</h2>
        <ul class="arrow-list">{learnings.map((item) => <li>{item}</li>)}</ul>
      </section>
    )}

    <RelatedContent title="相关内容" relatedProjects={relatedProjects} relatedDecisions={relatedDecisions} />
    <BackLink href="/projects" text="返回项目" />
  </main>
  <ScrollToTop />

  <style>
    .case-study { max-width: 900px; margin: 0 auto; padding: 3.5rem 1.5rem 6rem; }
    .case-study-header { padding-bottom: 2.5rem; margin-bottom: 3rem; border-bottom: 1px solid var(--color-border); }
    .header-badges { margin-bottom: .85rem; }
    .status-badge { display: inline-flex; padding: .3rem .6rem; border: 1px solid var(--color-border); border-radius: 4px; font-size: .7rem; font-weight: 650; color: var(--color-text-muted); }
    .status--ongoing { color: #22c55e; }
    h1 { font-size: clamp(2.4rem, 6vw, 4rem); line-height: 1.08; letter-spacing: -.04em; margin-bottom: 1rem; }
    .case-study-meta { display: flex; flex-wrap: wrap; gap: .55rem; color: var(--color-text-muted); font-size: .86rem; }
    .outcome-summary { margin-top: 1.25rem; max-width: 780px; font-size: 1.15rem; line-height: 1.75; color: var(--color-text-secondary); }
    .project-links { display: flex; flex-wrap: wrap; gap: .7rem; margin-top: 1.5rem; }
    .project-links a { padding: .55rem .8rem; border: 1px solid var(--color-border); border-radius: 6px; color: var(--color-text); font-size: .85rem; font-weight: 600; }
    .case-study-section { margin-bottom: 3.5rem; }
    .case-study-section h2, .case-study-content :global(h2) { font-size: 1.55rem; margin-bottom: 1.25rem; letter-spacing: -.02em; }
    .case-study-section > p, .case-study-content :global(p) { color: var(--color-text-secondary); font-size: 1.03rem; line-height: 1.85; }
    .section-title-row { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; margin-bottom: 1.25rem; }
    .section-title-row h2 { margin: 0; }
    .section-title-row span { color: var(--color-text-muted); font-size: .78rem; }
    .screenshot-list { display: grid; gap: 1.5rem; }
    .project-shot { margin: 0; }
    .project-shot img, .evidence-item img { display: block; width: 100%; height: auto; border: 1px solid var(--color-border); border-radius: 8px; background: var(--color-bg-secondary); }
    .project-shot figcaption { margin-top: .6rem; color: var(--color-text-muted); font-size: .8rem; line-height: 1.6; }
    .timeline { border-top: 1px solid var(--color-border); }
    .timeline-item { display: grid; grid-template-columns: 90px 1fr; gap: 1.25rem; padding: 1.25rem 0; border-bottom: 1px solid var(--color-border); }
    .timeline-year { color: var(--color-text-muted); font-size: .86rem; font-weight: 650; }
    .timeline-item h3 { margin: 0 0 .45rem; font-size: 1.02rem; }
    .timeline-item p { margin: 0; color: var(--color-text-secondary); line-height: 1.75; }
    .timeline-metrics { display: flex; flex-wrap: wrap; gap: .7rem 1rem; margin-top: .8rem; color: var(--color-text-muted); font-size: .8rem; }
    .timeline-metrics strong { color: var(--color-text); }
    .evidence-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; margin-top: 1.25rem; }
    .evidence-item { margin: 0; }
    .evidence-item figcaption { display: grid; gap: .25rem; margin-top: .55rem; }
    .evidence-item figcaption strong { font-size: .88rem; }
    .evidence-item figcaption span { color: var(--color-text-muted); font-size: .78rem; line-height: 1.55; }
    .file-evidence { display: grid; gap: .4rem; padding: 1rem; border: 1px solid var(--color-border); border-radius: 8px; background: var(--color-bg-secondary); color: var(--color-text); text-decoration: none; }
    .file-evidence span { color: var(--color-text-muted); font-size: .8rem; line-height: 1.55; }
    .file-evidence .file-open { margin-top: .35rem; color: var(--color-text); font-weight: 600; }
    .decisions-list { display: grid; gap: 1rem; }
    .decision-item { padding: 1.35rem; background: var(--color-bg-secondary); border: 1px solid var(--color-border); border-radius: 8px; }
    .decision-item h3 { margin-bottom: .7rem; font-size: 1.1rem; }
    .decision-item p { color: var(--color-text-secondary); line-height: 1.75; }
    .alternatives { margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--color-border); }
    .alternatives strong { display: block; margin-bottom: .5rem; color: var(--color-text-muted); font-size: .75rem; }
    .alternatives ul { margin: 0; padding-left: 1.2rem; color: var(--color-text-secondary); line-height: 1.7; }
    .tag-cloud { display: flex; flex-wrap: wrap; gap: .5rem; }
    .tag-cloud span { padding: .35rem .6rem; background: var(--color-bg-secondary); border: 1px solid var(--color-border); border-radius: 5px; color: var(--color-text-secondary); font-size: .8rem; }
    .arrow-list { list-style: none; padding: 0; }
    .arrow-list li { position: relative; padding: .45rem 0 .45rem 1.35rem; color: var(--color-text-secondary); line-height: 1.75; }
    .arrow-list li::before { content: "→"; position: absolute; left: 0; color: var(--color-accent); }
    .case-study-content { margin: 1rem 0 3.5rem; padding-top: 2rem; border-top: 1px solid var(--color-border); }
    .case-study-content :global(h3) { margin: 1.8rem 0 .8rem; }
    .case-study-content :global(ul) { margin: .8rem 0 1.4rem; padding-left: 1.25rem; color: var(--color-text-secondary); line-height: 1.75; }
    .case-study-content :global(a) { text-decoration: underline; text-underline-offset: 3px; }
    @media (max-width: 640px) {
      .case-study { padding: 2.5rem 1rem 4rem; }
      .case-study-section { margin-bottom: 3rem; }
      .section-title-row { align-items: flex-start; flex-direction: column; gap: .35rem; }
      .timeline-item { grid-template-columns: 1fr; gap: .45rem; }
      .evidence-grid { grid-template-columns: 1fr; }
    }
  </style>
</BaseLayout>
