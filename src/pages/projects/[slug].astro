---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SEO from '../../components/SEO.astro';
import StructuredData from '../../components/StructuredData.astro';
import ScrollToTop from '../../components/ScrollToTop.astro';
import BackLink from '../../components/BackLink.astro';
import RelatedContent from '../../components/RelatedContent.astro';
import ImpactMetrics from '../../components/ImpactMetrics.astro';
import { getCollection, getEntry, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id } }));
}
const { slug } = Astro.params;
const project = await getEntry('projects', slug!);
if (!project) return Astro.redirect('/404');
const { Content } = await render(project);
const { title, role, year, duration, outcomeSummary, overview, problem, constraints, approach, keyDecisions, techStack, impact, learnings, relatedProjects, relatedDecisions, status, stageLabel, showcaseCommit, screenshots, links } = project.data;
const defaultStage = { completed: '已完成', ongoing: '持续迭代', archived: '已归档' }[status || 'completed'];
const linkItems = [
  links?.live && { label: '线上产品 ↗', href: links.live },
  links?.github && { label: 'GitHub ↗', href: links.github },
  links?.release && { label: 'Release ↗', href: links.release },
].filter(Boolean) as { label: string; href: string }[];
---

<BaseLayout>
  <SEO slot="head" title={title} description={outcomeSummary} type="article" />
  <StructuredData type="Project" data={{ title, outcomeSummary, problem, techStack, year }} />
  <main class="case-study">
    <header class="case-study-header">
      <div class="header-badges"><span class:list={['status-badge', `status--${status}`]}>{stageLabel ?? defaultStage}</span></div>
      <h1>{title}</h1>
      <div class="case-study-meta">
        <span>{role}</span><span>·</span><span>{duration ?? year}</span>
        {showcaseCommit && <><span>·</span><span>展示基线 {showcaseCommit.slice(0, 7)}</span></>}
      </div>
      <p class="outcome-summary">{outcomeSummary}</p>
      {linkItems.length > 0 && <div class="project-links">{linkItems.map((link) => <a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a>)}</div>}
    </header>

    <section class="case-study-section"><h2>项目概览</h2><p>{overview}</p></section>
    <section class="case-study-section"><h2>问题从哪里来</h2><p>{problem}</p></section>
    <section class="case-study-section"><h2>关键约束</h2><ul class="arrow-list">{constraints.map((item) => <li>{item}</li>)}</ul></section>
    <section class="case-study-section"><h2>我的做法</h2><p>{approach}</p></section>

    {screenshots && screenshots.length > 0 && (
      <section class="case-study-section">
        <h2>界面与真实使用</h2>
        <div class="screenshot-list">
          {screenshots.map((shot) => (
            <figure class="project-shot">
              <img src={shot.src} alt={shot.alt} loading="lazy" />
              {shot.caption && <figcaption>{shot.caption}</figcaption>}
            </figure>
          ))}
        </div>
      </section>
    )}

    <section class="case-study-section">
      <h2>关键决策</h2>
      <div class="decisions-list">
        {keyDecisions.map((item) => (
          <article class="decision-item">
            <h3>{item.decision}</h3>
            <p>{item.reasoning}</p>
            {item.alternatives && item.alternatives.length > 0 && <div class="alternatives"><strong>当时也考虑过</strong><ul>{item.alternatives.map((alt) => <li>{alt}</li>)}</ul></div>}
          </article>
        ))}
      </div>
    </section>
    <section class="case-study-section"><h2>技术与工具</h2><div class="tag-cloud">{techStack.map((tech) => <span>{tech}</span>)}</div></section>
    <section class="case-study-section"><h2>结果与证据</h2>{impact.metrics && impact.metrics.length > 0 && <ImpactMetrics metrics={impact.metrics} />}<p>{impact.qualitative}</p></section>
    <section class="case-study-section"><h2>复盘</h2><ul class="arrow-list">{learnings.map((item) => <li>{item}</li>)}</ul></section>
    {project.body && project.body.trim().length > 0 && <section class="case-study-content"><Content /></section>}
    <RelatedContent title="相关内容" relatedProjects={relatedProjects} relatedDecisions={relatedDecisions} />
    <BackLink href="/projects" text="返回项目案例" />
  </main>
  <ScrollToTop />

  <style>
    .case-study { max-width:820px; margin:0 auto; padding:3.5rem 1.5rem 6rem; }
    .case-study-header { padding-bottom:2.5rem; margin-bottom:3rem; border-bottom:1px solid var(--color-border); }
    .header-badges { margin-bottom:.85rem; }
    .status-badge { display:inline-flex; padding:.3rem .6rem; border:1px solid var(--color-border); border-radius:4px; font-size:.7rem; font-weight:650; color:var(--color-text-muted); }
    .status--ongoing { color:#22c55e; }
    h1 { font-size:clamp(2.4rem,6vw,4rem); line-height:1.08; letter-spacing:-.04em; margin-bottom:1rem; }
    .case-study-meta { display:flex; flex-wrap:wrap; gap:.55rem; color:var(--color-text-muted); font-size:.86rem; }
    .outcome-summary { margin-top:1.25rem; font-size:1.2rem; line-height:1.75; color:var(--color-text-secondary); }
    .project-links { display:flex; flex-wrap:wrap; gap:.7rem; margin-top:1.5rem; }
    .project-links a { padding:.55rem .8rem; border:1px solid var(--color-border); border-radius:6px; color:var(--color-text); font-size:.85rem; font-weight:600; }
    .case-study-section { margin-bottom:3.5rem; }
    .case-study-section h2,.case-study-content :global(h2) { font-size:1.55rem; margin-bottom:1.25rem; letter-spacing:-.02em; }
    .case-study-section>p,.case-study-content :global(p) { color:var(--color-text-secondary); font-size:1.05rem; line-height:1.85; }
    .arrow-list { list-style:none; padding:0; }
    .arrow-list li { position:relative; padding:.45rem 0 .45rem 1.35rem; color:var(--color-text-secondary); line-height:1.75; }
    .arrow-list li::before { content:"→"; position:absolute; left:0; color:var(--color-accent); }
    .decisions-list { display:grid; gap:1rem; }
    .decision-item { padding:1.35rem; background:var(--color-bg-secondary); border:1px solid var(--color-border); border-radius:8px; }
    .decision-item h3 { margin-bottom:.7rem; font-size:1.1rem; }
    .decision-item p { color:var(--color-text-secondary); line-height:1.75; }
    .alternatives { margin-top:1rem; padding-top:1rem; border-top:1px solid var(--color-border); }
    .alternatives strong { display:block; margin-bottom:.5rem; color:var(--color-text-muted); font-size:.75rem; }
    .alternatives ul { margin:0; padding-left:1.2rem; color:var(--color-text-secondary); line-height:1.7; }
    .screenshot-list { display:grid; gap:1.5rem; }
    .project-shot { margin:0; }
    .project-shot img { display:block; width:100%; height:auto; border:1px solid var(--color-border); border-radius:8px; background:var(--color-bg-secondary); }
    .project-shot figcaption { margin-top:.6rem; color:var(--color-text-muted); font-size:.8rem; line-height:1.6; }
    .tag-cloud { display:flex; flex-wrap:wrap; gap:.5rem; }
    .tag-cloud span { padding:.35rem .6rem; background:var(--color-bg-secondary); border:1px solid var(--color-border); border-radius:5px; color:var(--color-text-secondary); font-size:.8rem; }
    .case-study-content { margin:1rem 0 3.5rem; padding-top:2rem; border-top:1px solid var(--color-border); }
    .case-study-content :global(h3) { margin:1.8rem 0 .8rem; }
    .case-study-content :global(ul) { margin:.8rem 0 1.4rem; padding-left:1.25rem; color:var(--color-text-secondary); line-height:1.75; }
    @media (max-width:640px) { .case-study { padding:2.5rem 1rem 4rem; } .case-study-section { margin-bottom:3rem; } }
  </style>
</BaseLayout>
