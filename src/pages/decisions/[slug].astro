---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SEO from '../../components/SEO.astro';
import ScrollToTop from '../../components/ScrollToTop.astro';
import BackLink from '../../components/BackLink.astro';
import RelatedContent from '../../components/RelatedContent.astro';
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const decisions = await getCollection('decisions');
  return decisions.map((decision) => ({ params: { slug: decision.id }, props: { decision } }));
};
type DecisionEntry = Awaited<ReturnType<typeof getCollection<'decisions'>>>[number];
interface Props { decision: DecisionEntry; }
const { decision } = Astro.props;
const { Content } = await render(decision);
const formattedDate = new Intl.DateTimeFormat('zh-CN', { year:'numeric', month:'long', day:'numeric' }).format(decision.data.date);
---

<BaseLayout>
  <SEO slot="head" title={decision.data.title} description={decision.data.context} type="article" />
  <main class="decision-page">
    <article>
      <header class="decision-header">
        <time datetime={decision.data.date.toISOString()}>{formattedDate}</time>
        <h1>{decision.data.title}</h1>
        {decision.data.tags && <div class="tags">{decision.data.tags.map((tag) => <span>{tag}</span>)}</div>}
        {decision.data.sourceUrl && <a class="source-link" href={decision.data.sourceUrl} target="_blank" rel="noopener noreferrer">原始 ADR ↗</a>}
      </header>

      <section><h2>当时是什么情况</h2><p>{decision.data.context}</p></section>
      <section><h2>最后怎么定的</h2><p class="decision-highlight">{decision.data.decision}</p></section>
      <section>
        <h2>还考虑过什么</h2>
        <div class="alternatives">
          {decision.data.alternatives.map((alt) => (
            <article>
              <h3>{alt.option}</h3>
              <div class="alt-grid">
                {alt.pros && <div><strong>好处</strong><ul>{alt.pros.map((item) => <li>{item}</li>)}</ul></div>}
                {alt.cons && <div><strong>问题</strong><ul>{alt.cons.map((item) => <li>{item}</li>)}</ul></div>}
              </div>
            </article>
          ))}
        </div>
      </section>
      <section><h2>为什么这么定</h2><p>{decision.data.reasoning}</p></section>

      {decision.body && decision.body.trim().length > 0 && <section class="decision-body"><Content /></section>}
      <RelatedContent title="相关内容" relatedProjects={decision.data.relatedProjects} relatedDecisions={decision.data.relatedDecisions} />
      <BackLink href="/decisions" text="返回关键决策" />
    </article>
  </main>
  <ScrollToTop />

  <style>
    .decision-page { max-width:820px; margin:0 auto; padding:3.5rem 1.5rem 6rem; }
    .decision-header { padding-bottom:2.5rem; margin-bottom:3rem; border-bottom:1px solid var(--color-border); }
    time { color:var(--color-text-muted); font-size:.85rem; }
    h1 { margin:.65rem 0 1rem; font-size:clamp(2.2rem,5vw,3.5rem); line-height:1.12; letter-spacing:-.035em; }
    .tags { display:flex; flex-wrap:wrap; gap:.5rem; margin-bottom:1rem; }
    .tags span { padding:.25rem .5rem; border:1px solid var(--color-border); border-radius:4px; color:var(--color-text-muted); font-size:.72rem; }
    .source-link { display:inline-block; margin-top:.5rem; font-size:.85rem; font-weight:600; }
    section { margin-bottom:3rem; }
    section h2 { margin-bottom:1rem; font-size:1.35rem; }
    section>p { color:var(--color-text-secondary); line-height:1.85; font-size:1.04rem; }
    .decision-highlight { padding:1rem 1.2rem; border-left:3px solid var(--color-accent); background:var(--color-bg-secondary); border-radius:0 6px 6px 0; color:var(--color-text); }
    .alternatives { display:grid; gap:1rem; }
    .alternatives article { padding:1.2rem; border:1px solid var(--color-border); border-radius:8px; background:var(--color-bg-secondary); }
    .alternatives h3 { margin-bottom:.9rem; font-size:1rem; }
    .alt-grid { display:grid; grid-template-columns:1fr 1fr; gap:1.25rem; }
    .alt-grid strong { display:block; margin-bottom:.45rem; color:var(--color-text-muted); font-size:.75rem; }
    .alt-grid ul { margin:0; padding-left:1.1rem; color:var(--color-text-secondary); line-height:1.7; }
    .decision-body { padding-top:2rem; border-top:1px solid var(--color-border); }
    .decision-body :global(p) { color:var(--color-text-secondary); line-height:1.85; margin-bottom:1rem; }
    .decision-body :global(h2),.decision-body :global(h3) { margin:1.7rem 0 .8rem; }
    @media (max-width:640px) { .decision-page { padding:2.5rem 1rem 4rem; } .alt-grid { grid-template-columns:1fr; } }
  </style>
</BaseLayout>
